# StaffSync Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String (full mongodb:// or mongodb+srv:// URI)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/staffsync?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/staffsync

# JWT Signing Secret (use a secure random string in production)
JWT_SECRET=staffsync_super_secret_jwt_key_change_in_production_2026

# Allowed Frontend Client Origin(s) for CORS (comma-separated if multiple)
# For local development: http://localhost:5173
# For Vercel production: https://staffsync-yourproject.vercel.app
CLIENT_URL=http://localhost:5173
